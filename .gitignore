# Large downloads, token files and training runs (rebuilt by the scripts)
data/text/
data/chat/
data/ds7/
data/qwen/
data/qwen_v2/
data/txgpt/
data/ds7_chat/
data/raw/fineweb-edu/
data/raw/smol-smoltalk/
data/external/
runs/

# DS1 raw API replies (about 0.4 GB; SHA-256 of each is in data/processed/esplora/manifest.json,
# and the trimmed data/processed/esplora/histories.json.gz is what ships)
data/raw/esplora/
# DS10's raw replies, the same way (data/processed/ds10/histories.json.gz ships)
data/raw/ds10/

# Round 2's DS7 (about 40,000 pairs) is built on Kaggle by kaggle/qwen_data; its glossary.jsonl and
# manifest.json (with each file's SHA-256) are committed, the pair files are not
data/processed/ds7_v2/train.jsonl
data/processed/ds7_v2/val.jsonl
data/processed/ds7_v2/test.jsonl

# DS4 processed rows (~2.9M rows; rebuilt in seconds by python -m explorer.cli process-external)
data/processed/bitcoinheist/rows.parquet

# DS2 crawl state: sampled blocks and raw addresses (only the hashed table in data/processed/corpus/ ships)
data/raw/corpus/
data/interim/

# Secret salt for hashing DS2 addresses (A1 risk 16); never committed or zipped
config/salt.txt

# Kaggle API token
kaggle.json

# Course material and notes for Claude Code; not part of the repository or the submission
_context/

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# DS3 Elliptic is CC BY-NC-ND 4.0: no processed rows may be redistributed
data/processed/elliptic/*
!data/processed/elliptic/download.json

# Large fitted models (rebuilt by their steps). heist_best.joblib is a 276 MB random forest, over
# GitHub's 100 MB limit; the zip will carry a smaller final model or a link with SHA-256.
models/heist_best.joblib
# The two language-model writers (settings.json "assistant"): the 152M model (610 MB in fp32) and the Qwen 3B
# adapter (114 MB) are also over the limit; their SHA-256 are in context.txt until they ship as release assets.
models/assistant/
models/qwen3b_adapter/

# Console copies of logs that are already written to reports/logs/<step>.log
reports/logs/*.stdout.log
reports/logs/ext_*.log

# tools/run_queue.py: console copies of each step and its resume state (each job also writes its own log)
reports/logs/queue/
reports/logs/queue_state_*.json

# tools/test_report.py build folder (the PDF itself is reports/assistant_tests.pdf)
reports/assistant_tests/
