{
  "about": "Every job after the 152M pretraining, in run order (context.txt NEXT A and B). Qwen first (24 Oct): the most-used writer, and the one job never run on this GPU, so it starts while someone is awake. Run: python tools/run_queue.py --plan configs/queue_after_pretraining.json (cos30049-a2-gpu).",
  "steps": [
    {"name": "prepare-tx", "run": ["-m", "lm.prepare_tx"],
     "wait_for": ["data/processed/corpus/ds2.parquet", "data/processed/corpus/manifest.json"],
     "check": ["data/txgpt/meta.json"]},
    {"name": "build-ds7", "run": ["-m", "explorer.cli", "build-ds7"],
     "wait_for": ["data/processed/corpus/ds2.parquet", "data/processed/corpus/manifest.json"],
     "check": ["data/processed/ds7/train.jsonl", "data/processed/ds7/val.jsonl", "data/processed/ds7/test.jsonl"]},
    {"name": "prepare-ds7-chat", "after": ["build-ds7"],
     "run": ["-m", "lm.prepare_chat", "--source", "jsonl", "--jsonl", "data/processed/ds7/train.jsonl",
             "--val-jsonl", "data/processed/ds7/val.jsonl", "--out", "data/ds7_chat"],
     "check": ["data/ds7_chat/meta.json"]},
    {"name": "eval-template", "after": ["build-ds7"], "run": ["-m", "lm.eval_explain", "--model", "template"],
     "check": ["reports/tables/assistant_eval_template.csv"]},

    {"name": "qwen-bench", "after": ["build-ds7"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.qlora", "--config", "configs/qwen3b_explain.json", "--bench"]},
    {"name": "qwen-train", "after": ["build-ds7", "qwen-bench"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.qlora", "--config", "configs/qwen3b_explain.json"],
     "check": ["runs/qwen3b-explain/adapter_best/adapter_model.safetensors", "runs/qwen3b-explain/meta.json"]},
    {"name": "eval-qwen", "after": ["qwen-train"], "gpu": true,
     "run": ["-m", "lm.eval_explain", "--model", "qwen3b", "--config", "configs/qwen3b_explain.json",
             "--adapter", "runs/qwen3b-explain/adapter_best"],
     "check": ["reports/tables/assistant_eval_qwen3b.csv"]},

    {"name": "txgpt-s-s1", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_s.json", "--seed", "1"], "check": ["runs/txgpt-s-s1/model.pt"]},
    {"name": "txgpt-m-s1", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_m.json", "--seed", "1"], "check": ["runs/txgpt-m-s1/model.pt"]},
    {"name": "txgpt-l-s1", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_l.json", "--seed", "1"], "check": ["runs/txgpt-l-s1/model.pt"]},
    {"name": "txgpt-s-s2", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_s.json", "--seed", "2"], "check": ["runs/txgpt-s-s2/model.pt"]},
    {"name": "txgpt-m-s2", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_m.json", "--seed", "2"], "check": ["runs/txgpt-m-s2/model.pt"]},
    {"name": "txgpt-l-s2", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_l.json", "--seed", "2"], "check": ["runs/txgpt-l-s2/model.pt"]},
    {"name": "txgpt-s-s3", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_s.json", "--seed", "3"], "check": ["runs/txgpt-s-s3/model.pt"]},
    {"name": "txgpt-m-s3", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_m.json", "--seed", "3"], "check": ["runs/txgpt-m-s3/model.pt"]},
    {"name": "txgpt-l-s3", "after": ["prepare-tx"], "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/txgpt_l.json", "--seed", "3"], "check": ["runs/txgpt-l-s3/model.pt"]},

    {"name": "tx-select", "run": ["-m", "lm.tx_select"],
     "after": ["txgpt-s-s1", "txgpt-m-s1", "txgpt-l-s1", "txgpt-s-s2", "txgpt-m-s2", "txgpt-l-s2",
               "txgpt-s-s3", "txgpt-m-s3", "txgpt-l-s3"],
     "check": ["models/txgpt.pt", "models/txgpt_meta.json", "reports/tables/txgpt_runs.csv", "reports/tables/txgpt_sizes.csv"]},
    {"name": "tx-baselines", "after": ["tx-select"], "gpu": true,
     "run": ["-m", "lm.tx_baselines", "--model", "models/txgpt.pt"], "check": ["reports/tables/txgpt_nll.csv"]},
    {"name": "tx-score", "after": ["tx-select"], "gpu": true, "run": ["-m", "lm.tx_score", "--plants"],
     "check": ["data/processed/esplora/txgpt_scores.csv"]},
    {"name": "txgpt-method", "after": ["tx-score"], "run": ["-m", "explorer.cli", "txgpt"],
     "check": ["reports/tables/tuning_txgpt.csv", "models/txgpt_method.joblib"]},
    {"name": "scores", "after": ["txgpt-method"], "run": ["-m", "explorer.cli", "scores"]},
    {"name": "evaluate", "after": ["scores"], "run": ["-m", "explorer.cli", "evaluate"],
     "check": ["reports/tables/eval_selection.csv"]},

    {"name": "chat-152m", "gpu": true, "wait_for": ["runs/text-150m/model.pt"],
     "run": ["-m", "lm.train", "--config", "configs/text_150m_chat.json"], "check": ["runs/text-150m-chat/model.pt"]},
    {"name": "explain-152m", "after": ["chat-152m", "prepare-ds7-chat"], "gpu": true,
     "run": ["-m", "lm.train", "--config", "configs/text_150m_explain.json"], "check": ["runs/text-150m-explain/model.pt"]},
    {"name": "eval-152m", "after": ["explain-152m"], "gpu": true,
     "run": ["-m", "lm.eval_explain", "--model", "text150m", "--checkpoint", "runs/text-150m-explain/model_best.pt"],
     "check": ["reports/tables/assistant_eval_text150m.csv"]}
  ]
}
