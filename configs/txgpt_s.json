{
  "name": "txgpt-s",
  "data_dir": "data/txgpt",
  "out_dir": "runs/txgpt-s",
  "model": {
    "seq_len": 768,
    "n_layer": 4,
    "n_head": 4,
    "d_model": 128,
    "mlp_hidden": 352,
    "dropout": 0.1
  },
  "epochs": 20,
  "batch_tokens": 24576,
  "micro_batch": 32,
  "lr": 0.001,
  "min_lr": 0.0001,
  "warmup_steps": 100,
  "weight_decay": 0.1,
  "eval_every": 100,
  "eval_batches": 10,
  "early_stop_evals": 5,
  "ckpt_every_minutes": 10
}
