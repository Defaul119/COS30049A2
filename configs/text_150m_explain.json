{
  "name": "text-150m-explain",
  "data_dir": "data/ds7_chat",
  "out_dir": "runs/text-150m-explain",
  "init_from": "runs/text-150m-chat/model.pt",
  "epochs": 3,
  "batch_tokens": 32768,
  "micro_batch": 4,
